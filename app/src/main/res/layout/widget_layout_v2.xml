<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_premium"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title with serif -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Dollar Block"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="italic"
        android:letterSpacing="0.02" />

    <!-- Session status -->
    <TextView
        android:id="@+id/widget_session_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:text="No active session"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:letterSpacing="0.05" />

    <!-- Session timer (large) -->
    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-light"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Minimalist button -->
    <TextView
        android:id="@+id/widget_action_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/widget_button_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="START SESSION"
        android:textColor="#000000"
        android:textSize="13sp"
        android:letterSpacing="0.1" />

    <!-- Blocked apps count -->
    <TextView
        android:id="@+id/widget_blocked_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:text="3 apps blocked"
        android:textColor="#666666"
        android:textSize="11sp"
        android:letterSpacing="0.05" />

</LinearLayout>
